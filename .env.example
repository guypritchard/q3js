# Absolute directory containing baseq3/pak0.pk3 and any optional mod directories.
# Forward slashes are the most portable form when using Podman on Windows.
Q3JS_DATA_DIR=C:/Games/Quake III Arena

# Development defaults are supplied by compose.yml. Override these before exposing
# the services outside your local machine.
Q3JS_EVENT_CLIENT_SECRET=replace-with-at-least-32-url-safe-characters
Q3JS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
