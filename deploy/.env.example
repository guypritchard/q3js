# Persistent deployment root on CT 101's SSD-backed /srv/sites mount.
Q3JS_DEPLOY_ROOT=/srv/sites/q3js

# Generate each value independently with: openssl rand -hex 32
Q3JS_DB_PASSWORD=replace-with-a-random-secret
Q3JS_EVENT_CLIENT_SECRET=replace-with-a-random-secret
Q3JS_ADMIN_PASSWORD=replace-with-a-random-secret
